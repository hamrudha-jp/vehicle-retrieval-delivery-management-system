# VRDMS Production Environment Configuration Template
# Copy to .env or inject these variables in your deployment environment (Docker, Cloud, VM)

# Backend Server Port
PORT=8080

# Production Database (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/vrdms_db
DB_USERNAME=postgres
DB_PASSWORD=your_production_postgres_password

# Production JWT Secret (REQUIRED in production - Minimum 32 characters / 256 bits)
JWT_SECRET=YourProductionSecretKeyHereMinimum32CharsLengthRequired
JWT_EXPIRATION=86400000

# Backend CORS Allowed Origins (Comma-separated production domains)
ALLOWED_ORIGINS=https://your-frontend-domain.com

# Initial Administrator Bootstrap (Only evaluated when no ADMIN exists in the database)
ADMIN_EMAIL=admin@vrdms.com
ADMIN_PASSWORD=your_secure_admin_password
ADMIN_NAME=System Administrator
ADMIN_PHONE=+919876543210

# Active Spring Profile (Set to prod for production mode)
SPRING_PROFILES_ACTIVE=prod

# Frontend Production API URL (Used during Vite production build: npm run build)
VITE_API_URL=https://your-backend-domain.com

